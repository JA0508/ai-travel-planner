{
  "name": "travel-itinerary-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "test:workspace": "node --import tsx --test src/features/trip-workspace/*.test.ts src/features/imports/*.test.ts src/features/intent-confirmation/*.test.ts src/features/preplan-intent/*.test.ts src/features/executable-route-preview/*.test.ts src/features/product-reset-prototype/*.test.tsx",
    "test:browser-smoke": "node --import tsx --test src/features/intent-confirmation/*.smoke.test.tsx src/features/preplan-intent/*.smoke.test.tsx src/features/executable-route-preview/*.smoke.test.tsx",
    "test:e2e:intent": "TRIP_API_PROXY_TARGET=http://127.0.0.1:8018 npm run build && playwright test --config=playwright.intent.config.ts",
    "test:e2e:product-reset": "npm run build && playwright test --config=playwright.product-reset.config.ts",
    "start": "next start"
  },
  "dependencies": {
    "next": "15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.5",
    "tsx": "^4.23.1",
    "typescript": "5.8.3"
  }
}
