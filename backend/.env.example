APP_ENV=development
POI_DISCOVERY_MODE=fallback
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# Required when APP_ENV=production and POI_DISCOVERY_MODE=required.
# Powers POI geocoding, route lookup, stay/departure advice, and realtime
# Completion Task candidate discovery.
AMAP_API_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=10

# Optional: enables LLM-assisted parsing/disambiguation when configured.
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENAI_INTENT_TIMEOUT_SECONDS=20
OPENAI_DISAMBIGUATION_TIMEOUT_SECONDS=15

# TripRevision persistence foundation.
TRIP_STORE_MODE=sqlite
TRIP_STORE_PATH=data/trips.sqlite3
TRIP_STORE_BUSY_TIMEOUT_SECONDS=5
TRIP_CAPABILITY_COOKIE_SECURE=false
TRIP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRIP_REPLAN_PROPOSAL_TTL_SECONDS=900

# Text import review foundation.
IMPORT_TEXT_ENABLED=true
IMPORT_TEXT_MAX_BYTES=102400
IMPORT_ARTIFACT_STORE_MODE=local
IMPORT_ARTIFACT_ROOT=data/import-artifacts
IMPORT_PROCESSING_MODE=inline
IMPORT_EXTRACTOR_MODE=deterministic
IMPORT_RESOLVER_MODE=deterministic
IMPORT_MAX_MENTIONS=60
IMPORT_MAX_RESOLUTION_CANDIDATES=5
