APP_ENV=development
POI_DISCOVERY_MODE=fallback
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# Required when APP_ENV=production and POI_DISCOVERY_MODE=required.
# Powers POI geocoding, route lookup, stay/departure advice, and realtime
# Completion Task candidate discovery.
AMAP_API_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=10

# Optional: enables LLM-assisted parsing/disambiguation when configured.
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENAI_INTENT_TIMEOUT_SECONDS=20
OPENAI_DISAMBIGUATION_TIMEOUT_SECONDS=15

# TripRevision persistence foundation.
TRIP_STORE_MODE=sqlite
TRIP_STORE_PATH=data/trips.sqlite3
TRIP_STORE_BUSY_TIMEOUT_SECONDS=5
TRIP_CAPABILITY_COOKIE_SECURE=false
TRIP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRIP_REPLAN_PROPOSAL_TTL_SECONDS=900

# Text import review foundation.
IMPORT_TEXT_ENABLED=true
IMPORT_TEXT_MAX_BYTES=102400
IMPORT_URL_ENABLED=true
IMPORT_URL_FETCHER_MODE=network
IMPORT_URL_MAX_REDIRECTS=5
IMPORT_URL_CONNECT_TIMEOUT_SECONDS=5
IMPORT_URL_READ_TIMEOUT_SECONDS=10
IMPORT_URL_TOTAL_TIMEOUT_SECONDS=20
IMPORT_URL_MAX_COMPRESSED_BYTES=2097152
IMPORT_URL_MAX_DECODED_BYTES=5242880
IMPORT_URL_MAX_TEXT_BYTES=512000
IMPORT_URL_CACHE_TTL_SECONDS=900
IMPORT_URL_ALLOWED_PORTS=80,443
IMPORT_URL_USER_AGENT=AITravelPlannerURLImporter/1.0
IMPORT_URL_ROBOTS_FAIL_CLOSED=true
IMPORT_ARTIFACT_STORE_MODE=local
IMPORT_ARTIFACT_ROOT=data/import-artifacts
IMPORT_BINARY_ENABLED=true
IMPORT_BINARY_MAX_IMAGE_BYTES=12582912
IMPORT_BINARY_MAX_PDF_BYTES=20971520
IMPORT_BINARY_UPLOAD_CHUNK_BYTES=65536
IMPORT_BINARY_STAGING_ROOT=data/import-staging
IMPORT_INSPECTION_MODE=subprocess
IMPORT_INSPECTION_TIMEOUT_SECONDS=10
IMPORT_INSPECTION_MAX_MEMORY_MB=512
IMPORT_INSPECTION_MAX_OUTPUT_BYTES=262144
IMPORT_IMAGE_MAX_PIXELS=40000000
IMPORT_IMAGE_MAX_DIMENSION=12000
IMPORT_PDF_MAX_PAGES=80
IMPORT_PDF_MAX_OBJECTS=5000
IMPORT_DOCUMENT_EXTRACTION_ENABLED=true
IMPORT_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=20
IMPORT_DOCUMENT_EXTRACTION_MAX_MEMORY_MB=768
IMPORT_DOCUMENT_EXTRACTION_MAX_OUTPUT_BYTES=1048576
IMPORT_DOCUMENT_MAX_TEXT_BYTES=512000
IMPORT_DOCUMENT_OCR_COMMAND=tesseract
IMPORT_DOCUMENT_OCR_LANGUAGES=eng+chi_sim
IMPORT_DOCUMENT_OCR_TIMEOUT_SECONDS=10
IMPORT_PDF_PAGE_OCR_ENABLED=true
IMPORT_PROCESSING_MODE=inline
IMPORT_EXTRACTOR_MODE=deterministic
IMPORT_RESOLVER_MODE=deterministic
IMPORT_MAX_MENTIONS=60
IMPORT_MAX_RESOLUTION_CANDIDATES=5
